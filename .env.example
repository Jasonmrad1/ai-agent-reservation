# Zero-credit MVP defaults. Do not enable live AI while testing offline.
APP_MODE=simulator
NODE_ENV=development
SIMULATOR_LIVE_AI=false
PORT=3000
DATABASE_URL=data/automation.sqlite
ADMIN_SESSION_SECRET=change_in_production_with_32_random_bytes
SETTINGS_ENCRYPTION_KEY=
PUBLIC_BASE_URL=
CLINIC_SETUP_REVIEWED=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
STATUS_CALLBACK_URL=
ADMIN_WHATSAPP_NUMBER=whatsapp:+96171000000
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_INVOICE=
WHATSAPP_TEMPLATE_SCHEDULE_CHANGE=
WHATSAPP_TEMPLATE_ADMIN_ALERT=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODELS=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/admin/oauth2callback
HOME_VISIT_BUFFER_MINUTES=30
PAYMENT_INSTRUCTIONS=Contact the clinic for available payment methods.

# Optional service-role replica; use deployment/replica-schema.sql in a new project.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional separate encrypted backup mount; otherwise data/backups is used.
BACKUP_DIRECTORY=
